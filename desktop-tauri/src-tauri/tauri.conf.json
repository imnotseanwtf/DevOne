{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevOne",
  "version": "0.1.0",
  "identifier": "dev.devone.tauri",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node prepare.mjs",
    "beforeBuildCommand": "node prepare.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "DevOne",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "runtime": "runtime" }
  }
}
